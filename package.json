    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.5",
    "@types/node": "^20.10.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/uuid": "^11.0.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.16",
    "concurrently": "^9.1.2",
    "dotenv": "^17.2.4",
    "i18next-parser": "^9.3.0",
    "patch-package": "^8.0.1",
    "pkg": "^5.8.0",
    "playwright": "^1.57.0",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.19.2",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vitest": "^1.6.1"
  },
  "optionalDependencies": {
    "@parcel/watcher-darwin-arm64": "^2.5.6",
    "@parcel/watcher-darwin-x64": "^2.5.6",
    "@parcel/watcher-linux-x64-glibc": "^2.5.6",
    "@parcel/watcher-win32-x64": "^2.5.6"
  }
}
