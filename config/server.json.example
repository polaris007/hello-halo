{
  "$schema": "./server-config-schema.json",
  "server": {
    "host": "127.0.0.1",
    "port": 3000
  },
  "auth": {
    "mode": "normal",
    "simpleToken": "",
    "headerName": "X-User-Id",
    "defaultPassword": "your-secure-password"
  },
  /*
  // hybrid 模式示例（支持简单令牌和JWT令牌）
  "auth": {
    "mode": "hybrid",
    "simpleToken": "your-simple-token",
    "headerName": "X-User-Id",
    "defaultPassword": "your-secure-password"
  },
  */
  "aiSources": {
    "providers": [
      {
        "id": "anthropic",
        "name": "Anthropic",
        "type": "anthropic",
        "apiKey": "",
        "baseUrl": "https://api.anthropic.com"
      },
      {
        "id": "openai",
        "name": "OpenAI",
        "type": "openai",
        "apiKey": "",
        "baseUrl": "https://api.openai.com"
      }
    ]
  },
  "data": {
    "basePath": "./data",
    "maxUploadSize": 104857600
  }
}
