{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ServerConfig",
  "type": "object",
  "properties": {
    "server": {
      "type": "object",
      "properties": {
        "host": {
          "type": "string",
          "description": "服务器绑定地址"
        },
        "port": {
          "type": "integer",
          "description": "服务器端口"
        }
      },
      "required": ["host", "port"]
    },
    "auth": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["normal", "disabled", "hybrid", "header"],
          "description": "认证模式"
        },
        "simpleToken": {
          "type": "string",
          "description": "hybrid认证模式的简单令牌"
        },
        "headerName": {
          "type": "string",
          "description": "Header认证模式的Header名称"
        },
        "defaultPassword": {
          "type": "string",
          "description": "默认管理员密码"
        }
      },
      "required": ["mode"]
    },
    "aiSources": {
      "type": "object",
      "properties": {
        "providers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "description": "提供商ID"
              },
              "name": {
                "type": "string",
                "description": "显示名称"
              },
              "type": {
                "type": "string",
                "description": "类型"
              },
              "apiKey": {
                "type": "string",
                "description": "API密钥"
              },
              "baseUrl": {
                "type": "string",
                "description": "API基础URL"
              }
            },
            "required": ["id", "name", "type", "apiKey", "baseUrl"]
          }
        }
      },
      "required": ["providers"]
    },
    "data": {
      "type": "object",
      "properties": {
        "basePath": {
          "type": "string",
          "description": "数据目录路径"
        },
        "maxUploadSize": {
          "type": "integer",
          "description": "最大上传文件大小（字节）"
        }
      },
      "required": ["basePath", "maxUploadSize"]
    },
    "aiProvider": {
      "type": "string",
      "description": "当前使用的AI提供商ID"
    },
    "features": {
      "type": "object",
      "additionalProperties": {
        "type": "boolean"
      },
      "description": "功能开关配置"
    },
    "limits": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      },
      "description": "各种限制配置（如最大对话轮数等）"
    }
  },
  "required": ["server", "auth", "aiSources", "data"]
}